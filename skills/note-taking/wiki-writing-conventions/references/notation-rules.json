{
  "version": 1,
  "updated": "2026-10-19",
  "families": [
    {
      "id": "classical-groups",
      "name": "经典群",
      "doc": "`\\mathrm{GL}_n(K)`、`\\mathrm{SL}_n`、`\\mathrm{PGL}_n`、`\\mathrm{PSL}_n`、`\\mathrm{O}`、`\\mathrm{SO}`、`\\mathrm{U}`、`\\mathrm{SU}`、`\\mathrm{Sp}`：字母正体，阶数作下标",
      "doc_ban": "`\\mathcal{GL}`、`\\text{GL}`、裸 `GL`（数学段内）",
      "scope": {
        "courses": [
          "数学/代数",
          "数学/分析",
          "物理/理论力学"
        ]
      },
      "fix": [
        {
          "pattern": "\\\\mathcal\\{((?:P?G|P?S)L)\\}",
          "repl": "\\\\mathrm{\\1}"
        },
        {
          "pattern": "\\\\(?:mathrm|operatorname|text)\\s+(P?GL|P?SL|SO|SU|Sp|O|U)(?![A-Za-z])",
          "repl": "\\\\mathrm{\\1}"
        },
        {
          "pattern": "\\\\(?:mathrm|operatorname|text)\\{((?:P?G|P?S)L)\\}",
          "repl": "\\\\mathrm{\\1}"
        },
        {
          "pattern": "(?<![\\\\{A-Za-z])(P?G)[lL](?![A-Za-z])",
          "repl": "\\\\mathrm{\\1L}"
        },
        {
          "pattern": "(?<![\\\\{A-Za-z])(P?S)[lL](?![A-Za-z])",
          "repl": "\\\\mathrm{\\1L}"
        },
        {
          "pattern": "(?<![\\\\{A-Za-z])(P?GL|P?SL)(?![A-Za-z])",
          "repl": "\\\\mathrm{\\1}"
        }
      ]
    },
    {
      "id": "symmetric-group",
      "name": "对称群",
      "doc": "`\\mathfrak{S}_n`（哥特体 S）",
      "doc_ban": "`S_n`、`\\mathcal{S}_n`、`\\mathbb{S}_n`",
      "scope": {
        "courses": [
          "数学/代数/代数III",
          "数学/代数/代数I"
        ]
      },
      "fix": [
        {
          "pattern": "\\\\mathfrak\\s+(S)(?=_)",
          "repl": "\\\\mathfrak{\\1}"
        },
        {
          "pattern": "(?<![\\\\{A-Za-z])S_\\{(n(?:\\s*[+\\-]\\s*\\d+)?)\\}",
          "repl": "\\\\mathfrak{S}_{\\1}"
        },
        {
          "pattern": "(?<![\\\\{A-Za-z])S_(n|[3-7])(?![A-Za-z0-9])",
          "repl": "\\\\mathfrak{S}_\\1"
        }
      ]
    },
    {
      "id": "alternating-group",
      "name": "交错群",
      "doc": "`\\mathfrak{A}_n`",
      "doc_ban": "`A_n`、`\\mathcal{A}_n`",
      "scope": {
        "courses": [
          "数学/代数/代数III"
        ]
      },
      "fix": [
        {
          "pattern": "\\\\mathfrak\\s+(A)(?=_)",
          "repl": "\\\\mathfrak{\\1}"
        },
        {
          "pattern": "(?<![\\\\{A-Za-z])A_\\{(n(?:\\s*[+\\-]\\s*\\d+)?|[4567])\\}",
          "repl": "\\\\mathfrak{A}_{\\1}"
        },
        {
          "pattern": "(?<![\\\\{A-Za-z])A_([4567]|n)(?![A-Za-z0-9])",
          "repl": "\\\\mathfrak{A}_\\1"
        }
      ]
    },
